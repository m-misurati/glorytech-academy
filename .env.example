# Public Supabase values. Use a publishable key only; never put a secret/service-role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Optional public Telegram channel username (without @) for Telegram Post Widget embeds.
# The matching lesson object also needs a telegramMessageId value.
VITE_TELEGRAM_CHANNEL=

# Optional public contact email shown on the landing page.
VITE_CONTACT_EMAIL=
